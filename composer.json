{
    "name": "litebasedb/litebasedb-laravel",
    "authors": [
        {
            "name": "Thiery Laverdure",
            "email": "thiery@spacestud.io"
        }
    ],
    "autoload": {
        "psr-4": {
            "LitebaseDB\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LitebaseDB\\Tests\\": "tests"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../litebase-php"
        }
    ],
    "require": {
        "php": "^8.0",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/support": "^7.0|^8.0",
        "litebasedb/litebasedb-php": "dev-develop"
    },
    "require-dev": {
        "illuminate/database": "^8.0",
        "orchestra/testbench": "^6.0",
        "phpunit/phpunit": "^8.0"
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "extra": {
        "laravel": {
            "providers": [
                "LitebaseDB\\LitebaseDBServiceProvider"
            ]
        }
    }
}
